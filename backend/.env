# Copy this file to .env and fill in real values.
# The server runs fine with NONE of this set - submissions are still saved
# to the database (SQLite by default). Email sending is optional on top.

PORT=4000
DEBUG=true

# Comma-separated list of hosts this server will answer for in production
# (Django's ALLOWED_HOSTS). Fine to leave as * in development.
ALLOWED_HOSTS=*

# Django's own secret key (session/CSRF signing) -- separate from JWT_SECRET
# below. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=DJANGO_SECRET_KEY=fErXAkdiy3oL2Y8exqSFaS63LQxoAlQI8sY4Zs6FJyHFjchd3w3QzwfFE97WDfaOir8

# Secret used to sign login sessions (JWT). MUST be set to a long random
# string in production -- anyone who has this value can forge login tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=ktdpD3FjvclJ40r8zKhTNBQ_454n6i2-Xfz0rWQKLIBMdf0mdiLrHzdDe3nkhMgM

# Comma-separated list of frontend origins allowed to call this API.
# Defaults (if unset) cover common local dev setups: Vite (5173), a plain
# static server (8080), and VS Code Live Server (5500).
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5500

# In production, set this to your real frontend domain, e.g.:
# ALLOWED_ORIGIN=https://mmc-group.com

# Used to build the link inside password reset emails, e.g.:
# https://mmc-group.com/reset-password.html?token=...
FRONTEND_URL=http://localhost:8080

# --- SMTP (optional, for email notifications) ---
# Works with Gmail (use an App Password), SendGrid, Mailgun, Postmark, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Where contact form notifications get sent (defaults to SMTP_USER if unset)
CONTACT_TO_EMAIL=hello@mmc-group.com
